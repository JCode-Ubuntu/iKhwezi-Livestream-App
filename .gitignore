# Dependencies
node_modules/
.pnp/
.pnp.js

# Build outputs
dist/
build/

# Environment
.env
.env.local
.env.*.local
!frontend/.env.production

# Mobile signing (never commit)
*.keystore
*.jks
keystore.properties
frontend/android/keystore.properties

# Capacitor / Android build artifacts
frontend/android/.gradle/
frontend/android/build/
frontend/android/app/build/
frontend/android/local.properties
# Firebase config (contains project API key; each build machine adds its own —
# the Gradle build gracefully skips the google-services plugin when absent)
frontend/android/app/google-services.json

# Capacitor iOS
frontend/ios/App/Pods/
frontend/ios/DerivedData/

# Database
*.db
*.db-journal

# Storage (keep structure, ignore content)
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep
backend/storage/videos/*
!backend/storage/videos/.gitkeep
backend/storage/hls/*
!backend/storage/hls/.gitkeep
# Backup job artifacts (backend/jobs/backupJob.js output)
backend/storage/backups/
# Health probe scratch files (lib/health.js)
backend/storage/health/

# npm audit snapshots (regenerate with npm audit; not source)
audit-backend.json
audit-frontend.json

# Tester lists / operator CSV exports (PII — never commit)
play-console-tester-list/
ikhwezi-internal-testers.csv

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docker
.docker/
# Local compose overrides (host port remaps; machine-specific)
docker-compose.override.yml

# Logs
logs/
*.log
npm-debug.log*

# Testing
coverage/
