# iKHWEZI Production Environment Configuration
# Copy this file to .env and update values for your deployment

# ==================== BACKEND ====================
NODE_ENV=production
PORT=3001
JWT_SECRET=your_jwt_secret_here_change_this_in_production
ADMIN_KEY=your_admin_key_here_change_this_in_production
# ADMIN_KEY DISPOSITION (Phase 3A RBAC): the shared admin key no longer
# authorizes the admin panel — that now needs a logged-in account with the
# 'admin' role. The key keeps exactly two jobs during transition:
#   1) POST /api/admin/bootstrap/grant — grant the FIRST admin role to a
#      user (used once, with x-admin-key), then
#   2) PATCH /api/admin/users/:id/ban fallback while operators migrate.
# Every use is audited + logs a loud deprecation warning. Set
# ADMIN_KEY_ENABLED=false to hard-disable all key paths (V2-launch intent —
# leave true only until the first admin account exists).
ADMIN_KEY_ENABLED=true
# Shared secret nginx-rtmp sends (as ?secret=) when calling the on-publish
# webhooks. docker-compose passes the same value to BOTH the backend and the
# nginx-rtmp service (built from ./nginx, which renders it into nginx.conf).
# REQUIRED: compose refuses to start without it. Use only A-Z a-z 0-9 _ . ~ -
# (e.g. `openssl rand -hex 32`).
RTMP_WEBHOOK_SECRET=your_rtmp_webhook_secret_here_change_this_in_production
# WEBHOOK SOURCE ALLOW-LIST (Phase 3A): when true, on_publish callbacks are
# accepted ONLY from private/loopback IPs (the internal compose network
# where nginx-rtmp lives) — a leaked secret alone is then useless from the
# public internet. Default: ON in production, OFF in dev (manual host
# testing). nginx-rtmp lives on the compose network, so true is safe.
# Constant-time secret comparison is always enforced regardless.
RTMP_WEBHOOK_INTERNAL_ONLY=true

# ==================== DATABASE ====================
# Two mutually exclusive modes:
#
# 1) POSTGRESQL (production): set POSTGRES_PASSWORD (required by compose)
#    and keep DATABASE_URL pointing at the compose `postgres` service —
#    docker-compose.yml / docker-compose.dist.yml build the URL from the
#    POSTGRES_* values below. The backend runs versioned migrations
#    (backend/migrations/) automatically on boot against either database.
#      POSTGRES_USER   — compose default: ikhwezi
#      POSTGRES_PASSWORD — REQUIRED (no default in the dist compose file)
#      POSTGRES_DB     — compose default: ikhwezi
#    Set a real, strong password for anything beyond a local machine (this
#    repo is public).
POSTGRES_USER=ikhwezi
POSTGRES_PASSWORD=your_postgres_password_here_change_this_in_production
POSTGRES_DB=ikhwezi
# DATABASE_URL switches the backend to PostgreSQL (postgresql:// or
# postgres:// scheme). When OMITTED (or empty), the backend falls back to
# SQLite at storage/ikhwezi.db — the local-dev experience, no Postgres
# needed. docker-compose passes DATABASE_URL built from the POSTGRES_*
# values above automatically; set it here only for an external managed
# database (e.g. Render/Neon) not managed by compose.
DATABASE_URL=postgresql://ikhwezi:your_postgres_password_here_change_this_in_production@postgres:5432/ikhwezi
# DATABASE_SSL: TLS for the Postgres connection. Managed providers usually
# need it; the compose network does NOT (private network → set "false",
# which is what compose wires in). Default when unset is TLS on.
DATABASE_SSL=false
# ---- Automated encrypted backups (backend/jobs/backupJob.js) -------------
# Runs at boot, then every BACKUP_INTERVAL_HOURS. SQLite: verified VACUUM INTO
# snapshot; Postgres: honest skip (managed snapshots own that job).
#   BACKUP_DIR                where artifacts land (compose: /app/storage/backups)
#   BACKUP_ENCRYPTION_KEY     set = encrypt via openssl (empty = PLAIN files,
#                             named .UNENCRYPTED with a loud log line)
#   BACKUP_KEEP               retention per family, min 1 (never delete-to-zero);
#                             LOCAL ONLY — it never deletes bucket copies
#   BACKUP_INCLUDE_MEDIA      tar the uploads/ tree alongside the DB backup
#   BACKUP_INTERVAL_HOURS     run cadence (default 24)
# OFF-SITE SYNC: no separate knob — it is triggered by the S3_* variables in
# the MEDIA PIPELINE section below. When S3_BUCKET + S3_ACCESS_KEY_ID +
# S3_SECRET_ACCESS_KEY are set, every backup run ALSO uploads each finalized
# artifact (.enc/.UNENCRYPTED/plain) to the bucket under backups/<filename>,
# in addition to the docker volume. Upload failures never fail the backup
# (logged loudly, retried next run). Left empty → honest skip, one log line
# per run. Prune old bucket copies with the bucket's lifecycle rules — the
# app's retention never deletes off-site copies.
# Manual trigger: cd backend && npm run backup — same code path on demand.
# Walkthrough + restore: docs/ops/backup-restore.md
BACKUP_DIR=/app/storage/backups
BACKUP_ENCRYPTION_KEY=
BACKUP_KEEP=7
BACKUP_INCLUDE_MEDIA=true
BACKUP_INTERVAL_HOURS=24

# Guest-account hygiene: purge @guest.local accounts idle for more than
# GUEST_IDLE_DAYS (default 14). Purged guests never owned visible content;
# Wallet+Points companions go with them. Runs at boot, then daily.
GUEST_IDLE_DAYS=14

# ==================== PAYMENTS (provider-agnostic) ====================
# Wallet coin top-ups run through a provider-agnostic payment service
# (backend/services/payments/). Exactly one provider is active, selected by
# env: PayFast (SA gateway) takes precedence when configured, then Stripe,
# else the dev instant-grant (LOCAL DEV ONLY — refused in production).
#
# ── PayFast (production provider for the SA market) ──
# All four values required. Get them from PayFast Dashboard → Settings →
# Integration (sandbox dashboard for testing, live dashboard for go-live).
#   PAYFAST_MERCHANT_ID    numeric merchant id, e.g. 10000100
#   PAYFAST_MERCHANT_KEY   merchant key (sandbox: 46f0cd694581a)
#   PAYFAST_PASSPHRASE     passphrase set in the PayFast dashboard (REQUIRED —
#                          without it ITN signatures are not secured)
#   PAYFAST_ZAR_PER_USD    ZAR charged per USD of coins (ledger stays in USD
#                          coin terms; the ZAR charge is recorded in the
#                          payment row metadata for audit). e.g. 18 → 100
#                          coins (=$1) charge R18.00.
# Optional:
#   PAYFAST_MODE           sandbox (default) | live
#   PAYFAST_NOTIFY_URL     override ITN URL. Default when unset:
#                          <FRONTEND_URL>/api/payments/webhook/payfast
#   PAYFAST_SKIP_VALIDATE  1 disables the server-to-server /eng/query/validate
#                          confirmation (escape hatch for the known 403 issue
#                          some merchants hit since 2025-08; the MD5 signature
#                          check stays active). Leave unset in production.
# ITN (webhook) endpoint: POST /api/payments/webhook/payfast (form-encoded).
# In the PayFast dashboard set the ITN/notify URL to
#   https://<your-domain>/api/payments/webhook/payfast
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_ZAR_PER_USD=
PAYFAST_MODE=sandbox
PAYFAST_NOTIFY_URL=
PAYFAST_SKIP_VALIDATE=
#
# ── Stripe (paused / legacy) ──
# Kept wired for providers that need a hosted-redirect checkout. Both values
# set → Stripe Checkout; either unset → Stripe inactive (only relevant if
# PayFast is not configured).
#   STRIPE_SECRET_KEY      sk_live_... / sk_test_... from the Stripe dashboard
#   STRIPE_WEBHOOK_SECRET  whsec_... from the Stripe webhook endpoint config.
#                          Endpoint: POST /api/payments/webhook/stripe
#                          (alias POST /api/stripe/webhook), handles ONLY the
#                          checkout.session.completed event.
#   FRONTEND_URL           public site URL used to build redirect/notify URLs.
#                          Falls back to http://localhost:5173 when unset —
#                          production MUST set it to the public site URL.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=

# ==================== RTMP/STREAMING ====================
# RTMP_SERVER: internal ingest URL (Docker service name OK for nginx-rtmp callbacks)
RTMP_SERVER=rtmp://your-domain.com:1935/live
# RTMP_PUBLIC_SERVER: URL shown in Admin / OBS (must be reachable from your encoder)
RTMP_PUBLIC_SERVER=rtmp://your-domain.com:1935/live
# HLS_URL: public HLS base (production: https://your-domain.com/hls via frontend nginx proxy)
HLS_URL=https://your-domain.com/hls
# (Stream quality/bitrate are set on the ENCODER (OBS), not here — nginx-rtmp
#  passes through whatever the encoder sends.)

# ==================== MEETING A/V — LiveKit SFU ====================
# Group meetings get real audio/video when ALL FOUR are set; leave ALL FOUR
# empty for presence-only meetings (the honest fallback — the media-token
# route answers 501 and the UI shows "A/V not enabled").
#   LIVEKIT_URL: backend → SFU REST address (docker service name is fine,
#                e.g. http://livekit:7880)
#   LIVEKIT_PUBLIC_URL: browser/native → SFU websocket URL
#                (web uses the frontend nginx /livekit proxy, so
#                 wss://your-domain.com/livekit on production TLS setups;
#                 native apps must use this exact same wss:// URL)
#   LIVEKIT_API_KEY / LIVEKIT_API_SECRET: the livekit `keys:` entry — must
#                match docker-compose's LIVEKIT_CONFIG keys pair exactly.
#                Generate strongly (e.g. `openssl rand -hex 32` for each).
#                The secret stays server-side; the client only receives
#                short-lived per-meeting tokens minted after membership checks.
LIVEKIT_URL=http://livekit:7880
LIVEKIT_PUBLIC_URL=wss://your-domain.com/livekit
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
#   LIVEKIT_RTC_PORT_START / LIVEKIT_RTC_PORT_END: the UDP media relay range
#                published on the host (default 50000–60000, matching the SFU
#                config). On Windows hosts with Hyper-V/WinNAT reserved port
#                ranges overlapping this band, remap to a clear range —
#                START/END are used for BOTH the host publish and the SFU
#                `rtc.port_range_*`, so host and container always agree.
LIVEKIT_RTC_PORT_START=50000
LIVEKIT_RTC_PORT_END=60000

# ---- TURN relay for meeting A/V (coturn — WebRTC NAT traversal) -----------
# Some meeting participants sit behind hostile NATs (mobile carriers, strict
# firewalls) where direct UDP to LiveKit fails. A TURN relay lets their media
# flow through the server. LiveKit-server embeds any configured TURN endpoint
# into the client's signaling response — WEB/NATIVE APPS NEED NO CHANGES and
# no client env values: they receive TURN automatically, server-side only.
#
# coturn/coturn runs in BOTH compose files (ikhwezi-coturn). It uses
# --lt-cred-mech STATIC auth: TURN_USER/TURN_SECRET below must equal what
# the clients get handed. coturn-over-UDP needs no domain/TLS and works
# today; TURN-over-TLS (port 5349) is a documented future step — it needs
# this deployment's domain + certificate.
#
# SERVER-ONLY wiring — the LiveKit side is a rtc.turn_servers entry in
# LIVEKIT_CONFIG (top-level `rtc:` merge; compose can't conditionally append
# YAML, and an empty-host entry would crash livekit-server — not fail-open).
# At deployment, append to the livekit service's LIVEKIT_CONFIG:
#     rtc:
#       turn_servers:
#         - host: <host clients reach>   # e.g. ikhwezi.site
#           port: 3478
#           protocol: udp
#           username: TURN_USER
#           credential: TURN_SECRET
#
# Dev compose: runs with throwaway defaults; host ports 3479 (UDP+TCP) +
# 49160-49169/udp are mapped for native Android testing (override
# COTURN_HOST_PORT). Until you add the rtc.turn_servers block, coturn runs
# but LiveKit does not hand it to clients — meetings behave exactly as
# today (honest).
# Dist compose: REQUIREs TURN_USER/TURN_SECRET (compose refuses to start
# coturn without them — no open relays in production).
#
# Ports to open on the VPS firewall when TURN is in active use:
#   UDP 3478 (STUN/TURN listen) + UDP 49160-49169 (relay range).
#   The relay range is deliberately SMALL (~10 ports ≈ a handful of relayed
#   participants; each participant's allocations eat ports) — WIDEN IT with
#   scale via COTURN_RELAY_PORT_START/COTURN_RELAY_PORT_END (keep compose
#   ports:, firewall, and these two vars in sync).
TURN_USER=ikhwezi-turn
TURN_SECRET=
# COTURN_RELAY_PORT_START=49160
# COTURN_RELAY_PORT_END=49169
# COTURN_HOST_PORT=3479

# ==================== FILE UPLOAD ====================
# Upload size limits are enforced in code (backend/index.js multer config:
# 100 MB video / 50 MB media / 20 MB story / 50 MB ad) — no env knobs.

# ==================== MEDIA PIPELINE (PHASE 2) ====================
# Two INDEPENDENT switches — each fails OPEN (uploads NEVER fail because of
# these):
#
# 1) OBJECT STORAGE (uploads are copied to a bucket in the background; the
#    local file remains what the app serves — switching the app over to
#    serving FROM the bucket/CDN is a later phase).
#   S3_BUCKET + S3_ACCESS_KEY_ID + S3_SECRET_ACCESS_KEY set → S3/R2 driver;
#   left empty → local-disk driver (no copy, the default).
#   S3_ENDPOINT is required for Cloudflare R2/MinIO; leave empty for real AWS.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ENDPOINT=
# STORAGE_PUBLIC_URL: public base for publicUrl() (e.g. your CDN or bucket
# base). Optional — unset means callers use the backend's local path.
STORAGE_PUBLIC_URL=
# S3_PUBLIC_URL: legacy alias of STORAGE_PUBLIC_URL (STORAGE_PUBLIC_URL
# takes precedence when both are set). Exposed by compose for completeness;
# set only one of the two.
S3_PUBLIC_URL=
#
# PRICING NOTE (see PAYMENTS section): coin pricing is HARD-CODED in
# backend/index.js — 100 coins = $1.00, USD — not env-configurable.
#
# 2) TRANSCODE (FFmpeg renders extra size profiles of uploaded videos in the
#    background, e.g. "480p"). OFF by default — the app's behavior does not
#    change unless you turn this on.
#   TRANSCODE_ENABLED=true to enable; binaries come from ffmpeg-static, or
#   set FFMPEG_PATH to point at your system binary.
TRANSCODE_ENABLED=false
TRANSCODE_PROFILES=480p
FFMPEG_PATH=
#
# Job queue for transcode work: REDIS_URL set → BullMQ (best for multi-node
# or heavy load); empty → in-process executor (single-server default).
# The SAME REDIS_URL also switches rate limiting from per-process in-memory
# counters to shared Redis fixed-window counters (with in-memory fallback
# per request when Redis is unreachable).
REDIS_URL=


# (The old AWS_* block lived here — it was dead config: nothing in backend/
#  or compose reads those names. Use the S3_* vars in the MEDIA PIPELINE
#  section above.)
# (The old SMTP_* block was also dead config — no email sender is wired in
#  the backend; comms go through the in-app banner + push channels.)

# ==================== OBSERVABILITY (Phase 3B) ====================
# Structured logging: json | human. Default is human in dev, json in prod.
LOG_LEVEL=info
LOG_FORMAT=
# LOG_REQUESTS_HEALTH=true: log every /api/health and /api/ready hit.
# Default false in production so container probes don't drown logs.
LOG_REQUESTS_HEALTH=false

# Sentry error monitoring: set SENTRY_DSN to send unhandled 5xx errors.
# No DSN → no-op. @sentry/node must be npm-installed for the DSN to have
# any effect (otherwise a loud warning is logged and errors are not sent).
SENTRY_DSN=
# SENTRY_ENVIRONMENT: tag for the Sentry UI. Falls back to NODE_ENV
# (development) when unset.
SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE: release identifier shown in Sentry. Falls back to the
# package version (npm_package_version) when unset.
SENTRY_RELEASE=

# Alerting hooks: POST critical alerts to a webhook with HMAC-SHA256 sig.
# No URL → loud log line only. ALERT_WEBHOOK_SECRET signs the body.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=

# Health/readiness probe cache (ms). Prevents probe storms from hammering DB.
HEALTH_CACHE_TTL_MS=5000

# (Legacy LOG_FILE / LOG_MAX_SIZE / LOG_MAX_FILES removed — the logger now
# writes to stdout/stderr and the container runtime is responsible for
# collection.)
# (Legacy MONITORING / PERFORMANCE blocks (ENABLE_METRICS, METRICS_PORT,
#  DATADOG_ENABLED, CACHE_ENABLED, CACHE_TTL, DATABASE_CONNECTION_LIMIT,
#  REQUEST_TIMEOUT) removed — they were dead config: nothing in the backend
#  or compose reads those names. Health monitoring lives at /api/health +
#  /api/ready (see lib/health.js); the DB pool is configured in
#  config/database.js.)
