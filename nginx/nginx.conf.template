worker_processes auto;
rtmp_auto_push on;

events {
    worker_connections 1024;
}

rtmp {
    server {
        listen 1935;
        chunk_size 4096;
        
        application live {
            live on;
            record off;
            
            hls on;
            hls_path /tmp/hls;
            # Shorter segments + smaller playlist = much lower viewer delay
            hls_fragment 1;
            hls_playlist_length 4;
            hls_cleanup on;
            
            # Auto-notify backend when OBS starts/stops streaming.
            # nginx-rtmp cannot set custom headers, so the shared secret travels
            # as a query parameter. __RTMP_WEBHOOK_SECRET__ is substituted from
            # the RTMP_WEBHOOK_SECRET env var by docker-entrypoint.sh at start,
            # and __BACKEND_UPSTREAM__ from BACKEND_UPSTREAM (default
            # ikhwezi-backend:3001). This template is never used verbatim.
            on_publish http://__BACKEND_UPSTREAM__/api/live/on-publish?secret=__RTMP_WEBHOOK_SECRET__;
            on_publish_done http://__BACKEND_UPSTREAM__/api/live/on-publish-done?secret=__RTMP_WEBHOOK_SECRET__;
            
            deny play all;
        }
    }
}

http {
    sendfile on;
    tcp_nopush on;
    default_type application/octet-stream;

    # ---- HLS delivery hardening -------------------------------------------
    # Cache split, single source of truth (no Expires header: it would add a
    # second clock-dependent truth next to Cache-Control and multiplies drift
    # bugs on wrong-clocked clients; browsers honor Cache-Control alone).
    #   .m3u8 playlists — always "no-cache": the live window must be current
    #                     (a cached playlist = frozen picture).
    #   .ts segments    — write-once files (nginx-rtmp never reuses a segment
    #                     index, so a URL's bytes NEVER change) → safe to
    #                     cache "immutable" for a long window. A lagging
    #                     player that re-requests a pruned segment is BETTER
    #                     served by a warm cache than by a 404.
    map $uri $hls_cache_control {
        ~\.m3u8$   "no-cache";
        default    "public, max-age=3600, immutable";
    }

    # Compress ONLY the text playlists (application/vnd.apple.mpegurl, the
    # exact Content-Type the /hls location assigns). MPEG-TS segments are
    # already-compressed media — gzipping them burns CPU for ~0% gain.
    gzip on;
    gzip_types application/vnd.apple.mpegurl;
    gzip_vary on;
    gzip_min_length 100;

    server {
        listen 8080;
        
        location /hls {
            types {
                application/vnd.apple.mpegurl m3u8;
                video/mp2t ts;
            }
            
            root /tmp;

            if ($request_method = OPTIONS) {
                add_header Access-Control-Allow-Origin * always;
                add_header Access-Control-Allow-Methods 'GET, HEAD, OPTIONS' always;
                add_header Access-Control-Allow-Headers 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range' always;
                add_header Access-Control-Max-Age 86400 always;
                add_header Content-Length 0;
                add_header Content-Type text/plain;
                return 204;
            }
            
            add_header Cache-Control $hls_cache_control always;
            add_header Access-Control-Allow-Origin * always;
            add_header Access-Control-Allow-Methods 'GET, HEAD, OPTIONS' always;
            add_header Access-Control-Allow-Headers 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range' always;
        }
        
        location /stat {
            rtmp_stat all;
        }
        
        location /control {
            rtmp_control all;
        }

        # Prevent noisy 404 logs for unrelated paths (e.g. /admin).
        location / {
            return 404;
        }
    }
}
