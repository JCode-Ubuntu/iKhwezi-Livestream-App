{
  "appId": "com.ikhwezi.app",
  "appName": "iKHWEZI",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "hostname": "app.ikhwezi.local",
    "allowNavigation": [
      "ikhwezi.site",
      "*.ikhwezi.site"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "buildOptions": {
      "releaseType": "AAB"
    }
  },
  "ios": {
    "contentInset": "automatic",
    "scrollEnabled": false
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": false,
      "backgroundColor": "#000000",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#030014"
    },
    "Keyboard": {
      "resize": "body"
    }
  }
}
