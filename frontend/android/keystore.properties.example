# Copy to frontend/android/keystore.properties (never commit the real file).
# Generate upload key:
#   keytool -genkey -v -keystore ikhwezi-upload.keystore -alias ikhwezi -keyalg RSA -keysize 2048 -validity 10000

storeFile=../ikhwezi-upload.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=ikhwezi
keyPassword=YOUR_KEY_PASSWORD
