{
  "name": "ikhwezi-frontend",
  "version": "3.0.6",
  "contributors": [
    "Emil Kowalski (UI motion inspiration — https://emilkowal.ski/)"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:mobile": "vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build:mobile && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "android:bundle": "npm run native:brand && npm run cap:sync && cd android && gradlew.bat bundleRelease",
    "store:assets": "node scripts/generate-store-assets.mjs",
    "native:splash": "node scripts/generate-native-splash.mjs",
    "native:brand": "node scripts/generate-native-splash.mjs && node scripts/verify-native-branding.mjs",
    "verify:brand": "node scripts/verify-native-branding.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.0.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/keyboard": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "hls.js": "^1.5.7",
    "lucide-react": "^0.314.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.19",
    "vite": "^5.0.12"
  }
}
